<mujoco model="PaddleCrabSwimming">
	<include file="../common.xml" />
	<include file="model.xml" />

	<custom>
		<numeric name="agent_planner" data="0" />
		<!-- The horizon has to span a full stroke cycle, otherwise an oscillation
			 looks like wasted effort: the planner only sees the leg move away and
			 never sees the thrust it earns on the way back. -->
		<numeric name="agent_horizon" data="1.2" />
		<numeric name="agent_timestep" data="0.02" />
		<numeric name="sampling_trajectories" data="60" />
		<!-- 9 knots over 1.2 s = 0.15 s spacing, enough to resolve a ~1.5 Hz
			 stroke while keeping the search space small. -->
		<numeric name="sampling_spline_points" data="9" />
		<numeric name="sampling_exploration" data="0.3" />
		<!-- Slide the nominal plan forward instead of resampling it each iteration.
			 At ~5 replans/s against a 1.2 Hz stroke, resampling was eroding the
			 rhythm the planner had already found: measured +23% forward speed. -->
		<numeric name="sampling_sliding_plan" data="1" />
		<numeric name="gradient_spline_points" data="15" />
		<numeric name="estimator" data="0" />

		<!-- Swim-forward is world -Y, the side the rear paddles trail from. -->
		<numeric name="residual_ForwardAxisX" data="0.0" />
		<numeric name="residual_ForwardAxisY" data="-1.0" />
		<numeric name="residual_ForwardAxisZ" data="0.0" />

		<!-- Lead times on the steering errors. These have to stay small: a lead
			 term prices in angular velocity, and with large values every
			 exploratory stroke looks worse than lying still, so the planner never
			 leaves the do-nothing minimum. -->
		<numeric name="residual_LeadPath"     data="0.3 0 3.0" />
		<numeric name="residual_LeadAttitude" data="0.2 0 3.0" />

		<!-- First-order lag on each servo setpoint, applied by mjcb_act_dyn in
			 paddle_crab_swimming.cc. Swept over 0.02-0.30: 0.08 cuts joint
			 acceleration ~4x and slightly raises speed, while beyond ~0.15 the
			 filter starts eating the stroke itself. -->
		<numeric name="residual_ControlSmoothingTau" data="0.08 0.005 0.5" />

		<!-- Gait rhythm. StrokeFreq is the frequency Periodicity measures against
			 and the scale that turns (qdot, q) into a phasor; PhaseFront and
			 PhaseCentre are the commanded metachronal offsets of the front and
			 centre rows relative to the rear paddles. -->
		<numeric name="residual_StrokeFreq"  data="1.2 0.3 3.0" />
		<numeric name="residual_PhaseFront"  data="0.0 -3.15 3.15" />
		<numeric name="residual_PhaseCentre" data="0.0 -3.15 3.15" />
		<numeric name="residual_StrokeAmp"   data="1.0 0.0 1.57" />
	</custom>

	<!-- Forward uses the Null (linear) norm, so it is a reward on speed with a
		 gradient that never vanishes. The rest are quadratic penalties that shape
		 where the robot ends up, not how it moves to get there.
		 These weights were swept: raising Lateral/Heading above ~5 buys no extra
		 straightness and costs a third of the speed, because a swimming stroke
		 unavoidably rocks and yaws within each cycle. -->
	<sensor>
		<user name="Forward" dim="1"  user="-1 30.0 0 80.0" />
		<user name="Lateral" dim="1"  user="0   5.0 0 80.0" />
		<user name="Heading" dim="1"  user="0   5.0 0 80.0" />
		<user name="Level"   dim="2"  user="0   6.0 0 50.0" />
		<user name="Depth"   dim="1"  user="0   8.0 0 50.0" />
		<user name="Effort"  dim="18" user="0  0.02 0 10.0" />

		<!-- Gait rhythm terms, measured over 30 s runs against all-zero weights:
			 drift 0.077 -> 0.046 m, rhythm CV 0.43 -> 0.37, speed 0.050 -> 0.041.
			 Symmetry alone freezes the planner above ~0.6: at rest its residual is
			 zero and every exploratory wiggle is asymmetric, so moving always looks
			 worse. Periodicity is the opposite, large at rest, and holding it at 3
			 removed the freeze entirely even at Symmetry 4. -->
		<user name="Symmetry"    dim="18" user="0 1.0 0  2.0" />
		<user name="RowPhase"    dim="8"  user="0 0.0 0  2.0" />
		<user name="Periodicity" dim="6"  user="0 3.0 0 10.0" />

		<framepos    name="base_pos"    objtype="site" objname="base_cog" />
		<framelinvel name="base_linvel" objtype="site" objname="base_cog" />
		<frameangvel name="base_angvel" objtype="site" objname="base_cog" />
		<framexaxis  name="base_xaxis"  objtype="site" objname="base_cog" />
		<framezaxis  name="base_zaxis"  objtype="site" objname="base_cog" />
	</sensor>
</mujoco>
