<?xml version='1.0' encoding='utf-8'?>
<mujoco model="hexapod">
  <option integrator="implicitfast" jacobian="sparse" timestep="0.005" gravity="0 0 -0" density="1000" viscosity="0.0009" cone="elliptic" /><size memory="4G" />
  <visual>
    <scale com=".5" framewidth=".05" jointwidth=".01" />
    <global offheight="2160" offwidth="1920" />
  </visual>
  <default>
    <default class="dynamixel">
      <position ctrlrange="-3.14 3.14" ctrllimited="true" forcerange="-3.1 3.1" forcelimited="true" kp="30" />
    </default>
    <!-- controller = kp ki kd slewmax Imax Vmax;
         nominal = voltage stall_torque_Nm no_load_speed_rad_s (31 RPM here);
         saturation = torque_Nm current_A current_rate_A_s. The compiler derives
         forcerange = +-3.1 Nm. These motor ratings are not a body speed limit. -->
    <default class="leg_motor">
      <dcmotor nominal="12 3.1 3.24631" gear="1" input="position" controller="18 0 1.0 0 0 12" saturation="3.1 0 0" ctrlrange="-3.14159 3.14159" ctrllimited="true" />
    </default>
    <default class="DVL">
      <camera mode="fixed" resolution="2 2" fovy="45" />
    </default>
  </default>

  <asset>
      <mesh name="paddle" file="Swimming_Paddle.stl" scale=".001 .001 .001" />
      <mesh name="chassis" file="asset/chassis_oriented.stl" scale=".001 .001 .001" />
      <mesh name="foot" file="asset/foot_oriented.stl" scale=".001 .001 .001" />

  </asset>
  <worldbody>
      <camera pos="0.026 1.593 4.498" xyaxes="-1.000 0.017 0.000 -0.013 -0.728 0.685" name="main_camera" />
     <camera pos="0.732 1.193 3.466" xyaxes="-0.902 0.431 -0.000 -0.239 -0.500 0.832" name="legcam" />
      <camera pos="1.457 -1.139 3.433" xyaxes="0.564 0.826 0.000 -0.304 0.207 0.930" name="flipcam" />
      <camera pos="-1.457 -1.139 3.433" xyaxes="0.564 -0.826 0.000 0.304 0.207 0.930" name="flipcam_l" />

      <body name="plate" pos="0 00 1.5" euler="0 0 0" gravcomp=".3123">
        <site name="base_cog" pos="0 0 0" size="0.005" rgba="1 0 0 0" type="sphere" />
        <site name="front_point" pos="0 0.20 0" size="0.015" rgba="0 1 0 1" type="sphere" />
        <geom fluidshape="ellipsoid" type="mesh" mesh="chassis" pos="0 -.045 0" mass="5.825" rgba="0.5 0.5 0.5 0.5" />
        <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" euler="0 0 45" pos=".14 .18 .017" mass=".096" />
        <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos=".14 0 .017" mass=".096" />
        <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos=".14 -0.19 .017" euler="0 0 -45" mass=".096" />
        <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="-.14 .18 .017" euler="0 0 -45" mass=".096" />
        <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="-.14 0 .017" euler="0 0 0" mass=".096" />
        <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="-.14 -0.19 .017" euler="0 0 45" mass=".096" />
        <camera class="DVL" name="DVLcam" pos="0 0.168 -.02" euler="0 0 45" />

        <site name="DVL_site_front" type="box" pos="-0.01 0.178 -.02" zaxis="-0.5 0.5 -0.70710678" size="0.001 0.001 0.02" rgba="0 1 0 1" />
        <site name="DVL_site_back" type="box" pos="0.01 0.158 -.02" zaxis="0.5 -0.5 -0.70710678" size="0.001 0.001 0.02" rgba="0 0 1 1" />
        <site name="DVL_site_left" type="box" pos="-0.01 0.158 -.02" zaxis="-0.5 -0.5 -0.70710678" size="0.001 0.001 0.02" rgba="1 0 0 1" />
        <site name="DVL_site_right" type="box" pos="0.01 0.178 -.02" zaxis="0.5 0.5 -0.70710678" size="0.001 0.001 0.02" rgba="1 1 0 1" />

        <body name="buoyancy foam tl" pos="-.09 0.01 .02" gravcomp="23.33">
          <geom fluidshape="ellipsoid" type="box" size="0.02 0.13 0.02" rgba="0.2 0.2 0.2 1" mass="0.06" />
        </body>
        <body name="buoyancy foam tr" pos=".09 0.01 .02" gravcomp="23.33">
          <geom fluidshape="ellipsoid" type="box" size="0.02 0.13 0.02" rgba="0.2 0.2 0.2 1" mass="0.06" />
        </body>
        <body name="buoyancy foam bl" pos="-.09 0.01 -.02" gravcomp="23.33">
          <geom fluidshape="ellipsoid" type="box" size="0.02 0.13 0.02" rgba="0.2 0.2 0.2 1" mass="0.05" />
        </body>
        <body name="buoyancy foam br" pos=".09 0.01 -.02" gravcomp="23.33">
          <geom fluidshape="ellipsoid" type="box" size="0.02 0.13 0.02" rgba="0.2 0.2 0.2 1" mass="0.05" />
        </body>

        
        <body name="box" pos="0 0 0" euler="0 0 0">
          <camera pos="-.879 0.100 0.00" euler="0 -90 0" name="plate_camera" mode="track" />
          <site name="IMU" pos="0 0.051 0" euler="0 0 0" size="0.001 0.001 0.001" rgba="1 0 0 1" type="box" />
        </body>
        <freejoint />

        
        <body name="proximal segment front right" pos=".14 .18 0.017" euler="0 0 45" gravcomp=".5486">
          <geom fluidshape="ellipsoid" type="box" size=".02 0.01 .01" pos="0.04 0 0" />
          <joint name="psfr" type="hinge" axis="0 0 1" pos="0.01 0 0" damping="1" />
          <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.072 0 0" euler="90 0 0" mass=".096" />
          <body name="mid segment front right" pos=".072 0 0" euler="90 0 0" gravcomp=".5486">
            <geom fluidshape="ellipsoid" type="box" size=".04 0.01 .01" pos="0.04 0 0" />

            <joint name="msfr" type="hinge" axis="0 0 1" pos="0.01 0 0" damping="1" />
            <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.1 0 0" mass=".096" />

            <body name="distal segment front right" pos=".1 0 0" gravcomp=".5486">
              <joint name="dsfr" type="hinge" axis="0 0 1" pos="0.01 0 0" damping="1" />
              <geom fluidshape="ellipsoid" type="mesh" mesh="foot" pos="0.055 0 0" euler="0 0 180" />
              <site name="IK_site_fr" pos="0.09 0 0" euler="0 90 0" size="0.005 0.005 0.005" rgba="0 1 0 1" type="box" />
            </body>
          </body>
        </body>


 
        
        <body name="proximal segment center right" pos=".14 0 .017" euler="0 0 0" gravcomp=".5486">
          <geom fluidshape="ellipsoid" type="box" size=".02 0.01 .01" pos="0.04 0 0" />
          <joint name="pscr" type="hinge" axis="0 0 1" pos="0.01 0 0" damping="1" />
          <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.072 0 0" euler="90 0 0" mass=".096" />

          <body name="mid segment center right" pos=".072 0 0" euler="90 0 0" gravcomp=".5486">
            <geom fluidshape="ellipsoid" type="box" size=".04 0.01 .01" pos="0.04 0 0" />

            <joint name="mscr" type="hinge" axis="0 0 1" pos="0.01 0 0" damping="1" />
            <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.1 0 0" mass=".096" />

            <body name="distal segment center right" pos=".1 0 0" gravcomp=".5486">
              <joint name="dscr" type="hinge" axis="0 0 1" pos="0.01 0 0" damping="1" />
              <geom fluidshape="ellipsoid" type="mesh" mesh="foot" pos="0.055 0 0" euler="0 0 180" />
            </body>
          </body>
        </body>

        
        <body name="proximal segment back right" pos=".14 -.19 0.017" euler="0 0 -45" gravcomp=".5486">
          <geom fluidshape="ellipsoid" type="box" size=".02 0.01 .01" pos="0.04 0 0" />
          <joint name="psbr" type="hinge" axis="0 0 1" pos="0.01 0 0" damping="1" />
          <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.072 0 0" euler="90 0 0" mass=".096" />

          <body name="mid segment back right" pos=".072 0 0" euler="90 0 0" gravcomp=".5486">
            <geom fluidshape="ellipsoid" type="box" size=".025 0.01 .01" pos="0.04 0 0" />

            <joint name="msbr" type="hinge" axis="0 0 1" pos="0.01 0 0" damping="1" />
            <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.055 0.01 0" euler="0 0 90" mass=".096" />

            <body name="distal segment back right" pos="0.04 0 0" gravcomp="1">
              <joint name="dsbr" type="hinge" axis="1 0 0" pos="0.028 0.016 0" damping="1" />
              <geom fluidshape="ellipsoid" type="mesh" mesh="paddle" pos="0.03 0.03 -0.05" euler="0 0 -90" mass="0.34" />
              <site name="IK_site_br" pos="0.157 0.017 0" euler="0 0 0" size="0.005 0.005 0.005" rgba="0 1 0 1" type="box" />
            
            </body>

          </body>
        </body>

        
        <body name="proximal segment front left" pos="-.14 .18 0.017" euler="0 180 45" gravcomp=".5486">
          <geom fluidshape="ellipsoid" type="box" size=".02 0.01 .01" pos="0.04 0 0" />
          <joint name="psfl" type="hinge" axis="0 0 -1" pos="0.01 0 0" damping="1" />
          <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.072 0 0" euler="90 0 0" mass=".096" />
          <body name="mid segment front left" pos=".072 0 0" euler="90 0 0" gravcomp=".5486">
            <geom fluidshape="ellipsoid" type="box" size=".04 0.01 .01" pos="0.04 0 0" />

            <joint name="msfl" type="hinge" axis="0 0 -1" pos="0.01 0 0" damping="1" />
            <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.1 0 0" mass=".096" />

            <body name="distal segment front left" pos=".1 0 0" gravcomp=".5486">
              <joint name="dsfl" type="hinge" axis="0 0 -1" pos="0.01 0 0" damping="1" />
              <geom fluidshape="ellipsoid" type="mesh" mesh="foot" pos="0.055 0 0" euler="0 0 180" />
              <site name="IK_site_fl" pos="0.09 0 0" euler="0 90 0" size="0.005 0.005 0.005" rgba="0 .5 0 1" type="box" />

            </body>
          </body>
        </body>

        
        <body name="proximal segment center left" pos="-.14 0 0.017" euler="0 180 0" gravcomp=".5486">
          <geom fluidshape="ellipsoid" type="box" size=".02 0.01 .01" pos="0.04 0 0" />

          <joint name="pscl" type="hinge" axis="0 0 -1" pos="0.01 0 0" damping="1" />
          <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.072 0 0" euler="90 0 0" mass=".096" />

          <body name="mid segment center left" pos=".072 0 0" euler="90 0 0" gravcomp=".5486">
            <geom fluidshape="ellipsoid" type="box" size=".04 0.01 .01" pos="0.04 0 0" />
            <joint name="mscl" type="hinge" axis="0 0 -1" pos="0.01 0 0" damping="1" />
            <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.1 0 0" mass=".096" />

            <body name="distal segment center left" pos=".1 0 0" gravcomp=".5486">
              <joint name="dscl" type="hinge" axis="0 0 -1" pos="0.01 0 0" damping="1" />
              <geom fluidshape="ellipsoid" type="mesh" mesh="foot" pos="0.055 0 0" euler="0 0 180" />
            </body>
          </body>
        </body>

        
        <body name="proximal segment back left" pos="-.14 -.19 0.017" euler="0 180 -45" gravcomp=".5486">
          <geom fluidshape="ellipsoid" type="box" size=".02 0.01 .01" pos="0.04 0 0" />

          <joint name="psbl" type="hinge" axis="0 0 -1" pos="0.01 0 0" damping="1" />
          <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.072 0 0" euler="90 0 0" mass=".096" />

          <body name="mid segment back left" pos=".072 0 0" euler="90 0 0" gravcomp=".5486">
            <geom fluidshape="ellipsoid" type="box" size=".025 0.01 .01" pos="0.04 0 0" />

            <joint name="msbl" type="hinge" axis="0 0 -1" pos="0.01 0 0" damping="1" />
            <geom fluidshape="ellipsoid" type="box" size=".02325 0.01425 .017" pos="0.055 -0.01 0" euler="0 0 90" mass=".096" />

            <body name="distal segment back left" pos="0.04 0 0" gravcomp="1">
              <joint name="dsbl" type="hinge" axis="1 0 0" pos="0.028 -0.016 0" damping="1" />
              <geom fluidshape="ellipsoid" type="mesh" mesh="paddle" pos="0.03 -0.00 -0.05" euler="0 0 -90" mass="0.34" />
              <site name="IK_site_bl" pos="0.157 -0.017 0" euler="0 0 0" size="0.005 0.005 0.005" rgba="1 0 0 1" type="box" />
            </body>
          </body>
        </body>
      </body>

  </worldbody>

  <!-- Included after the crab's own bodies so 'plate' (not 'ground') is the
       first non-world body, matching mjlab's root_body_id = bodies[0] assumption. -->
  <include file="hfield_ground.xml" />

  <actuator>
    <!-- Per-joint ctrlrange tiers (same across all legs): proximal (peripheral)
         largest, mid in between, distal smallest. These override the leg_motor
         class default of +-3.14159. -->
    <dcmotor name="R1_1" joint="psfr" class="leg_motor" ctrlrange="-1.6 1.6"/>
    <dcmotor name="R1_2" joint="msfr" class="leg_motor" ctrlrange="-1.0 1.0"/>
    <dcmotor name="R1_3" joint="dsfr" class="leg_motor" ctrlrange="-0.5 0.5"/>

    <dcmotor name="R2_1" joint="pscr" class="leg_motor" ctrlrange="-1.6 1.6"/>
    <dcmotor name="R2_2" joint="mscr" class="leg_motor" ctrlrange="-1.0 1.0"/>
    <dcmotor name="R2_3" joint="dscr" class="leg_motor" ctrlrange="-0.5 0.5"/>

    <dcmotor name="R3_1" joint="psbr" class="leg_motor" ctrlrange="-1.6 1.6"/>
    <dcmotor name="R3_2" joint="msbr" class="leg_motor" ctrlrange="-1.0 1.0"/>
    <dcmotor name="R3_3" joint="dsbr" class="leg_motor" ctrlrange="-0.5 0.5"/>

    <dcmotor name="L1_1" joint="psfl" class="leg_motor" ctrlrange="-1.6 1.6"/>
    <dcmotor name="L1_2" joint="msfl" class="leg_motor" ctrlrange="-1.0 1.0"/>
    <dcmotor name="L1_3" joint="dsfl" class="leg_motor" ctrlrange="-0.5 0.5"/>

    <dcmotor name="L2_1" joint="pscl" class="leg_motor" ctrlrange="-1.6 1.6"/>
    <dcmotor name="L2_2" joint="mscl" class="leg_motor" ctrlrange="-1.0 1.0"/>
    <dcmotor name="L2_3" joint="dscl" class="leg_motor" ctrlrange="-0.5 0.5"/>

    <dcmotor name="L3_1" joint="psbl" class="leg_motor" ctrlrange="-1.6 1.6"/>
    <dcmotor name="L3_2" joint="msbl" class="leg_motor" ctrlrange="-1.0 1.0"/>
    <dcmotor name="L3_3" joint="dsbl" class="leg_motor" ctrlrange="-0.5 0.5"/>
    
  </actuator>
</mujoco>
